{
  "name": "carolina-portal-frontend",
  "version": "2.0.0",
  "description": "Frontend UI for Carolina order portal",
  "private": true,
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.16.0",
    "react-scripts": "5.0.1",
    "axios": "^1.6.0",
    "three": "0.160.0",
    "dxf-parser": "latest",
    "web-vitals": "^2.1.4",
    "occt-import-js": "^0.0.28"
  },
  "devDependencies": {
    "react-scripts": "5.0.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "postinstall": "node -e \"const fs=require('fs');const src='node_modules/occt-import-js/dist/occt-import-js.wasm';const dst='public/occt-import-js.wasm';try{fs.copyFileSync(src,dst);console.log('WASM copied')}catch(e){console.log('WASM copy skipped:',e.message)}\""
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "proxy": "http://localhost:5000"
}
